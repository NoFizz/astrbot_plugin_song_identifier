{
    "trigger": {
        "description": "触发设置",
        "type": "object",
        "hint": "触发识曲的消息条件：引用语音/视频消息 + @bot + 触发关键词（私聊无需 @）；也可用自然语言提问，由大模型自主调用识曲工具",
        "items": {
            "keyword": {
                "description": "识曲触发关键词",
                "type": "string",
                "default": "识曲",
                "hint": "引用语音/视频消息后 @bot 并发送该词，直接触发歌曲识别（不经过大模型）"
            }
        }
    },
    "engines": {
        "description": "识别引擎",
        "type": "object",
        "hint": "三档引擎按 首选→次选→备选 顺序尝试，首个识别成功的生效；留空的档位自动跳过",
        "items": {
            "select": {
                "description": "引擎选择",
                "type": "object",
                "hint": "每档只能选择一款引擎；某档识别失败或无结果时自动尝试下一档。选择「留空」则跳过该档",
                "items": {
                    "primary": {
                        "description": "首选引擎",
                        "type": "string",
                        "options": [
                            "ACRCloud",
                            "Shazam",
                            "讯飞开放平台/ACRCloud",
                            "讯飞开放平台/自研",
                            "留空"
                        ],
                        "default": "ACRCloud",
                        "hint": "优先使用的引擎。讯飞开放平台/ACRCloud = 原声识别（失败自动尝试哼唱）；讯飞开放平台/自研 = 仅哼唱识别"
                    },
                    "secondary": {
                        "description": "次选引擎",
                        "type": "string",
                        "options": [
                            "ACRCloud",
                            "Shazam",
                            "讯飞开放平台/ACRCloud",
                            "讯飞开放平台/自研",
                            "留空"
                        ],
                        "default": "讯飞开放平台/ACRCloud",
                        "hint": "首选引擎失败或无结果时尝试。选择「留空」则跳过"
                    },
                    "fallback": {
                        "description": "备选引擎",
                        "type": "string",
                        "options": [
                            "ACRCloud",
                            "Shazam",
                            "讯飞开放平台/ACRCloud",
                            "讯飞开放平台/自研",
                            "留空"
                        ],
                        "default": "Shazam",
                        "hint": "前两档都失败时的兜底引擎。选择「留空」则跳过"
                    }
                }
            },
            "acrcloud": {
                "description": "ACRCloud",
                "type": "object",
                "hint": "console.acrcloud.cn 注册获取；host 如 identify-cn-north-1.acrcloud.cn。仅支持原声识别（官方哼唱功能未公开）",
                "items": {
                    "host": {
                        "description": "Host",
                        "type": "string",
                        "default": ""
                    },
                    "access_key": {
                        "description": "Access Key",
                        "type": "string",
                        "default": ""
                    },
                    "access_secret": {
                        "description": "Access Secret",
                        "type": "string",
                        "default": ""
                    }
                }
            },
            "xfyun": {
                "description": "讯飞开放平台/ACRCloud",
                "type": "object",
                "hint": "原声识别（听歌识曲），识别失败时自动尝试哼唱识别。讯飞开放平台 console.xfyun.cn → 创建应用 → 语音扩展 → 歌曲识别 ACRCloud 页面获取（均为 32 位字符串）",
                "items": {
                    "app_id": {
                        "description": "AppID",
                        "type": "string",
                        "default": ""
                    },
                    "api_key": {
                        "description": "APIKey",
                        "type": "string",
                        "default": ""
                    },
                    "api_secret": {
                        "description": "APISecret",
                        "type": "string",
                        "default": ""
                    }
                }
            },
            "xfyun_humming": {
                "description": "讯飞开放平台/自研",
                "type": "object",
                "hint": "仅支持哼唱识别（哼唱猜歌）。同一应用开通歌曲识别（qbh）服务后获取；留空时自动复用上方讯飞开放平台/ACRCloud 凭据",
                "items": {
                    "app_id": {
                        "description": "AppID（留空复用上方）",
                        "type": "string",
                        "default": ""
                    },
                    "api_key": {
                        "description": "APIKey（留空复用上方）",
                        "type": "string",
                        "default": ""
                    }
                }
            }
        }
    },
    "output": {
        "description": "输出设置",
        "type": "object",
        "hint": "识别成功后的回复形式与内容开关",
        "items": {
            "format": {
                "description": "输出形式",
                "type": "string",
                "options": [
                    "文本",
                    "图片",
                    "卡片"
                ],
                "default": "文本",
                "hint": "文本=纯文本（格式可用下方模板自定义）；图片=图片卡片（含专辑封面）；卡片=QQ 音乐卡片（发送失败自动降级为文本）"
            },
            "text_template": {
                "description": "文本输出模板",
                "type": "string",
                "default": "{title} - {artist}",
                "editor_mode": true,
                "editor_language": "plaintext",
                "editor_theme": "vs-dark",
                "hint": "换行符：\\n 占位符：{title} 歌名、{artist} 歌手、{album} 专辑（{album} 仅 ACRCloud 系引擎有值）"
            },
            "title": {
                "description": "输出歌名",
                "type": "bool",
                "default": true
            },
            "artist": {
                "description": "输出歌手",
                "type": "bool",
                "default": true
            },
            "link": {
                "description": "输出试听链接",
                "type": "bool",
                "default": true,
                "hint": "所有输出形式生效：主内容发送后分条发送链接"
            },
            "card_platforms": {
                "description": "音乐卡片平台",
                "type": "object",
                "hint": "仅 card 输出形式生效：按 首选→次选 顺序尝试，首个发送成功的生效；「留空」跳过该档",
                "items": {
                    "primary": {
                        "description": "首选平台",
                        "type": "string",
                        "options": [
                            "网易云音乐",
                            "QQ音乐",
                            "留空"
                        ],
                        "default": "网易云音乐",
                        "hint": "优先使用的音乐卡片平台"
                    },
                    "secondary": {
                        "description": "次选平台",
                        "type": "string",
                        "options": [
                            "网易云音乐",
                            "QQ音乐",
                            "留空"
                        ],
                        "default": "QQ音乐",
                        "hint": "首选平台失败时尝试。选择「留空」则跳过"
                    }
                }
            }
        }
    },
    "advanced": {
        "description": "高级设置",
        "type": "object",
        "hint": "识别性能与媒体处理参数，一般无需修改",
        "items": {
            "identify_timeout": {
                "description": "识别超时（秒）",
                "type": "int",
                "default": 60,
                "hint": "整个识别链路（所有引擎）的总超时上限"
            },
            "audio_max_seconds": {
                "description": "视频音频截取时长（秒）",
                "type": "int",
                "default": 30,
                "hint": "识曲引擎建议识别 12 秒以内、文件小于 1MB（30 秒 ≈ 960KB）；超长音频会导致识别失败"
            },
            "debug_log": {
                "description": "Debug 日志输出",
                "type": "bool",
                "default": false,
                "hint": "开启后输出详细分步日志（媒体处理、引擎请求、响应内容等），便于排查问题；关闭后仅输出开始识曲、识别成功/失败等基础日志"
            }
        }
    }
}
