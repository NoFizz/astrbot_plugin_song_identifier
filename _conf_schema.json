{
    "trigger_keyword": {
        "description": "触发关键词（@bot 后输入该词 + 引用消息）",
        "type": "string",
        "default": "识曲"
    },
    "acrcloud_host": {
        "description": "ACRCloud 区域主机，如 identify-cn-north-1.acrcloud.com",
        "type": "string",
        "default": ""
    },
    "acrcloud_access_key": {
        "description": "ACRCloud Access Key",
        "type": "string",
        "default": ""
    },
    "acrcloud_access_secret": {
        "description": "ACRCloud Access Secret",
        "type": "string",
        "default": ""
    },
    "enable_shazam_fallback": {
        "description": "ACRCloud 识别失败时是否启用 Shazam 备用引擎",
        "type": "bool",
        "default": true
    },
    "output_title": {
        "description": "输出歌名",
        "type": "bool",
        "default": true
    },
    "output_artist": {
        "description": "输出歌手",
        "type": "bool",
        "default": true
    },
    "output_link": {
        "description": "输出试听链接",
        "type": "bool",
        "default": true
    },
    "output_format": {
        "description": "输出形式：text=纯文本，image=图片卡片（带专辑封面），card=QQ音乐卡片",
        "type": "string",
        "options": ["text", "image", "card"],
        "default": "text"
    },
    "identify_timeout": {
        "description": "识别超时（秒）",
        "type": "int",
        "default": 30
    },
    "humming_keyword": {
        "description": "哼唱识别触发关键词（引用语音消息 + @bot + 该词，走讯飞哼唱识别）",
        "type": "string",
        "default": "哼唱"
    },
    "engine_order": {
        "description": "音乐识别引擎顺序，逗号分隔：xfyun,acrcloud,shazam",
        "type": "string",
        "default": "xfyun,acrcloud,shazam"
    },
    "xfyun_app_id": {
        "description": "讯飞开放平台应用 AppID（歌曲识别 ACRCloud 音乐识别）",
        "type": "string",
        "default": ""
    },
    "xfyun_api_key": {
        "description": "讯飞 APIKey（歌曲识别 ACRCloud 音乐识别）",
        "type": "string",
        "default": ""
    },
    "xfyun_api_secret": {
        "description": "讯飞 APISecret（歌曲识别 ACRCloud 音乐识别）",
        "type": "string",
        "default": ""
    },
    "xfyun_humming_app_id": {
        "description": "讯飞 AppID（歌曲识别 qbh 哼唱识别，可与上面相同）",
        "type": "string",
        "default": ""
    },
    "xfyun_humming_api_key": {
        "description": "讯飞 APIKey（歌曲识别 qbh 哼唱识别）",
        "type": "string",
        "default": ""
    }
}
